    <!-- About screen -->
    <string name="about_title">About Persian Calendar</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_check_updates">See the latest version</string>
    <string name="about_what_title">What the app does</string>
    <string name="about_what_body">Persian Calendar shows each month as a grid of days. The day numbers can be Gregorian, the calendar used around the world, or Jalali, the Persian calendar. It converts a date from one calendar to the other and shows the time in Iran. Tap a day to add an event or see that day\'s events.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_no_data">The app does not collect, send or share any personal data.</string>
    <string name="about_privacy_events">Events you add are stored in a private database on your phone, and the app does not send them anywhere. Deleting the app or clearing its data removes this copy.</string>
    <string name="about_privacy_no_internet">The app has no internet permission, so it cannot send your data anywhere. It has no analytics, crash reporting or ads.</string>
    <string name="about_privacy_backup">If Android or Google account backup is on, your phone may include the app\'s data in your own Google backup. You and Google control that backup. We cannot see it.</string>

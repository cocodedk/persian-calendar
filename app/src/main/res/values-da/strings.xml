    <!-- Om-skærmen -->
    <string name="about_title">Om Jalali Persian Calendar</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_check_updates">Se den nyeste version</string>
    <string name="about_what_title">Hvad appen kan</string>
    <string name="about_what_body">Jalali Persian Calendar viser hver måned som et gitter af dage. Dagstallene følger enten den gregorianske kalender, som bruges over hele verden, eller den persiske kalender (jalali). Appen omregner en dato fra den ene kalender til den anden og viser klokkeslættet i Iran. Tryk på en dag for at tilføje en begivenhed eller se dagens begivenheder.</string>
    <string name="about_privacy_title">Privatliv</string>
    <string name="about_privacy_no_data">Appen indsamler, sender og deler ingen personoplysninger.</string>
    <string name="about_privacy_events">Begivenheder, du tilføjer, gemmes i en privat database på din telefon, og appen sender dem ikke nogen steder hen. Hvis du sletter appen eller rydder dens data, forsvinder denne kopi.</string>
    <string name="about_privacy_no_internet">Appen har ikke adgang til internettet, så den kan ikke sende dine data nogen steder hen. Den har hverken analyseværktøjer, fejlrapportering eller reklamer.</string>
    <string name="about_privacy_backup">Hvis Androids sikkerhedskopiering eller sikkerhedskopiering til din Google-konto er slået til, kan din telefon tage appens data med i din egen Google-sikkerhedskopi. Det er dig og Google, der styrer den sikkerhedskopi. Vi kan ikke se den.</string>
    <string name="about_privacy_link">Læs privatlivspolitikken</string>
